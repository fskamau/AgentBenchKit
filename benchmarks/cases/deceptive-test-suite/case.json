{
  "id": "deceptive-test-suite",
  "description": "Illustrate that a passing public suite may omit the actual zero-division bug",
  "test_command": [
    "python",
    "-m",
    "unittest",
    "discover",
    "-s",
    "tests",
    "-v"
  ],
  "oracle_command": [
    "python",
    "-m",
    "unittest",
    "discover",
    "-s",
    "oracle_tests",
    "-v"
  ],
  "allowed_changed_files": [
    "divide.py"
  ],
  "timeout_seconds": 30,
  "edge_cases": [
    "test_zero_denominator",
    "test_zero_over_zero"
  ]
}
